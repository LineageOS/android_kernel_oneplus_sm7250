TECHPACK?=y

techpack-dirs := $(shell find $(srctree)/techpack -maxdepth 1 -mindepth 1 -type d -not -name ".*")
ifeq ($(CONFIG_OPLUS_AVICII_CAMERA),y)
techpack-dirs := $(filter-out $(srctree)/techpack/camera $(srctree)/techpack/camera-bengal $(srctree)/techpack/camera-oplus,$(techpack-dirs))
else
techpack-dirs := $(filter-out $(srctree)/techpack/camera-avicii,$(techpack-dirs))
endif
obj-${TECHPACK} += stub/ $(addsuffix /,$(subst $(srctree)/techpack/,,$(techpack-dirs)))

techpack-header-dirs := $(shell find $(srctree)/techpack -maxdepth 1 -mindepth 1 -type d -not -name ".*")
ifeq ($(CONFIG_OPLUS_AVICII_CAMERA),y)
techpack-header-dirs := $(filter-out $(srctree)/techpack/camera $(srctree)/techpack/camera-bengal $(srctree)/techpack/camera-oplus,$(techpack-header-dirs))
else
techpack-header-dirs := $(filter-out $(srctree)/techpack/camera-avicii,$(techpack-header-dirs))
endif
header-${TECHPACK} += $(addsuffix /include/uapi/,$(subst $(srctree)/techpack/,,$(techpack-header-dirs)))
